{
  "identifier": "default",
  "description": "Default capability for Coco desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "log:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
